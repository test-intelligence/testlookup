{
  "name": "testlookup-reporter",
  "version": "1.0.0",
  "description": "TestLookup — JavaScript/TypeScript client SDK for live test execution streaming",
  "main": "dist/testlookup-reporter.js",
  "types": "dist/testlookup-reporter.d.ts",
  "exports": {
    ".": {
      "types": "./dist/testlookup-reporter.d.ts",
      "default": "./dist/testlookup-reporter.js"
    },
    "./jest-reporter": {
      "types": "./dist/jest-reporter.d.ts",
      "default": "./dist/jest-reporter.js"
    },
    "./mocha-reporter": {
      "types": "./dist/mocha-reporter.d.ts",
      "default": "./dist/mocha-reporter.js"
    },
    "./playwright-reporter": {
      "types": "./dist/playwright-reporter.d.ts",
      "default": "./dist/playwright-reporter.js"
    },
    "./vitest-reporter": {
      "types": "./dist/vitest-reporter.d.ts",
      "default": "./dist/vitest-reporter.js"
    },
    "./cypress-plugin": {
      "types": "./dist/cypress-plugin.d.ts",
      "default": "./dist/cypress-plugin.js"
    },
    "./cucumber-formatter": {
      "types": "./dist/cucumber-formatter.d.ts",
      "default": "./dist/cucumber-formatter.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "keywords": [
    "testlookup",
    "test-reporting",
    "live-streaming",
    "jest",
    "mocha",
    "playwright",
    "vitest",
    "cypress",
    "cucumber"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/mocha": "^10.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "jest": ">=27.0.0",
    "mocha": ">=9.0.0",
    "@playwright/test": ">=1.30.0",
    "vitest": ">=1.0.0",
    "cypress": ">=10.0.0",
    "@cucumber/cucumber": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    },
    "mocha": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "cypress": {
      "optional": true
    },
    "@cucumber/cucumber": {
      "optional": true
    }
  }
}
