{
  "name": "testlookup-reporter",
  "version": "1.0.0",
  "description": "TestLookup — JavaScript/TypeScript client SDK for live test execution streaming",
  "main": "dist/testlookup-reporter.js",
  "types": "dist/testlookup-reporter.d.ts",
  "exports": {
    ".":                { "types": "./dist/testlookup-reporter.d.ts", "default": "./dist/testlookup-reporter.js" },
    "./jest-reporter":  { "types": "./dist/jest-reporter.d.ts",       "default": "./dist/jest-reporter.js" },
    "./mocha-reporter": { "types": "./dist/mocha-reporter.d.ts",      "default": "./dist/mocha-reporter.js" },
    "./package.json":   "./package.json"
  },
  "scripts": {
    "build":    "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "files": ["dist", "src", "LICENSE"],
  "keywords": ["testlookup", "test-reporting", "live-streaming", "jest", "mocha"],
  "license": "Apache-2.0",
  "engines": { "node": ">=18.0.0" },
  "devDependencies": {
    "@types/node":        "^26.6.5",
    "@types/mocha":       "^10.0.0",
    "typescript":         "^5.3.0"
  },
  "peerDependencies": {
    "jest":   ">=27.0.0",
    "mocha":  ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "jest":  { "optional": true },
    "mocha": { "optional": true }
  }
}
