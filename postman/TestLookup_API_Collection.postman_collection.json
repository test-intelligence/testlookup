        {
          "name": "Generate Test Cases (Grounded)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('batch_id', pm.response.json().batch_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"prompt_text\": \"Generate test cases for the user authentication flow including login, logout, and password reset\",\n  \"source_ids\": [],\n  \"persist\": true\n}"
            },
            "url": "{{base_url}}/api/v1/test-management/cases/rag-generate",
