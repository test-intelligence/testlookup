        {
          "name": "Details (All Services)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/health/details" }
        }
      ]
    },
    {
      "name": "Projects",
      "description": "Project CRUD and membership management.",
      "item": [
        {
          "name": "List Projects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.length > 0) {",
                  "        pm.environment.set('project_id', json[0].id);",
                  "        console.log('project_id set to: ' + json[0].id);",
                  "    }",
