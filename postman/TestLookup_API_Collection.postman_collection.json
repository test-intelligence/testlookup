          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/projects",
            "description": "Lists all projects the current user has access to. Auto-saves first project_id."
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Test Project\",\n  \"slug\": \"my-test-project\",\n  \"description\": \"A sample project for API testing\",\n  \"jira_project_key\": \"MTP\"\n}"
            },
            "url": "{{base_url}}/api/v1/projects"
          }
        },
        {
          "name": "Get Project",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/projects/{{project_id}}" }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated project description\"\n}"
            },
            "url": "{{base_url}}/api/v1/projects/{{project_id}}"
          }
        },
        {
          "name": "List Project Members",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/projects/{{project_id}}/members" }
        }
      ]
    },
    {
      "name": "Test Runs",
      "description": "Test run listing, details, and test case browsing.",
      "item": [
        {
          "name": "List Test Runs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.items && json.items.length > 0) {",
                  "        pm.environment.set('run_id', json.items[0].id);",
                  "        console.log('run_id set to: ' + json.items[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/runs?project_id={{project_id}}&page=1&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "runs"],
              "query": [
                { "key": "project_id", "value": "{{project_id}}" },
                { "key": "page", "value": "1" },
                { "key": "size", "value": "20" },
                { "key": "status", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Test Run",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/runs/{{run_id}}" }
        },
        {
          "name": "List Test Cases in Run",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.items && json.items.length > 0) {",
                  "        pm.environment.set('test_case_id', json.items[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/runs/{{run_id}}/tests?page=1&size=50",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "runs", "{{run_id}}", "tests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "50" },
                { "key": "status", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Test Case Detail",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/runs/{{run_id}}/tests/{{test_case_id}}" }
        },
        {
          "name": "Regression Diff",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/runs/{{run_id}}/regression-diff" }
        },
        {
          "name": "Link Run to Release",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"release_name\": \"v1.2.0\"\n}" },
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/release"
          }
        }
      ]
    },
