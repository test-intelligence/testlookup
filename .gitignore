# Environment
.env
.env.local
.env.production

# Local backup archives (make backup) — contain real data, never commit
backups/

# Homelab credentials (generated by deploy script)
homelabsetup/.homelab-credentials

# ─── SECURITY: Never commit credentials or secrets ───────────────────────────
*creds*
*_creds*
*credentials*
*_secrets*
*secrets*
*.key
*.pem
*.p12
*.pfx
# TLS-interception root CAs staged into build contexts by deploy-homelab.sh.
# Host-specific (Norton/NordVPN/corporate proxy) — never commit. Keep the
# committed .keep sentinels so `COPY certs/` still works in CI.
**/certs/*.crt
.tls-mitm-ca.crt
*api_key*
*apikey*
# ─────────────────────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
# Suffixed variants too (.pytest_tmp_ui003_full, ...) — a bare
# `.pytest_tmp/` left every per-run basetemp dir untracked-but-visible.
.pytest_tmp*/

# Celery beat runtime state (regenerated at startup — not source)
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
coverage.xml
htmlcov/
# pytest-cov JSON report — a ~2.8 MB generated file that `git add -A` would
# sweep in after `pytest --cov-report=json`, which is how the coverage gaps in
# this repo get analysed. Its siblings above (.coverage, coverage.xml) were
# already ignored; this format was not.
backend/coverage.json

# vitest/v8 HTML coverage output (frontend/coverage/) — ~370 generated files
# that `git add -A` would otherwise sweep into a commit after `vitest --coverage`.
/frontend/coverage/
.venv/
venv/
homelabsetup/

# Node
node_modules/
frontend/dist/
frontend/.vite/
*.log

# Playwright auth state (contains JWT — never commit)
frontend/tests/e2e/.auth/
.ms-playwright/

# Java SDK build artifacts
client/java/target/
*.jar
*.class

# Docker
docker-compose.override.yml
website/
# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Kubernetes secrets (never commit real secrets)
k8s/**/secrets-real.yaml
k8s/**/secret-values.yaml

# Test artifacts — results belong in CI artifact storage, not source control
test-results.xml
test-results.txt
allure-results/
allure-report/

# Local scratch + design / AI-prototype hand-off artifacts (removed in
# chore/repo-cleanup — these are mockups/notes, not product source)
local_run.txt
*.zip
design_handoff_releases/
intelligence-selector.html
intelligence-selector.png
intelligence-selector-README.md
run-intelligence.html
run-intelligence-README.md
workflows-compute-graph-README.md
RUN_SUITE_COMPARISON_DESIGN.md
CLAUDE_CODE_LOGO_MIGRATION.md

# infra/aws — track the real AWS deployment IaC + scripts + docs, but keep the
# local-only Q&A scratch note (deployment_instructions.md) and TF working
# artifacts out. (.terraform/ etc. are handled by infra/aws/terraform/.gitignore.)
infra/aws/*
!infra/aws/terraform
!infra/aws/scripts
!infra/aws/README.md
!infra/aws/STRATEGY.md

# Coding-agent instruction files — keep on local disk only, NEVER commit to any
# branch. Untracked 2026-06-06; they still drive Claude Code / agents locally.
# (Pattern without a leading slash matches at every depth: root + backend/ + frontend/.)
CLAUDE.md
AGENTS.md

# Internal product / roadmap docs — archived on the local-only release/roadmap_docs
# branch; must not live on main. (Leading slash = repo-root only.)
/ROADMAP.md
/opensource.md
/deployment_and_testing_strategy.md

# Claude Code — keep local, never push to remote
.claude/
Product_Plan
frontend/playwright-report/
frontend/test-results
LintFailures
# Keep local scratch docs ignored; publish the maintained handoff suite.
/docs/*
!/docs/README.md
!/docs/product/
!/docs/architecture/
!/docs/pipelines/
!/docs/api/
!/docs/operations/
!/docs/handoff/
!/docs/reference/
!/docs/wiki/
!/docs/reviews/
BuildFailures/
CSS_Samples/
backend/celerybeat-schedule

# Build-time SDK staging dir (created by deploy-homelab.sh and the CI
# "Stage client SDKs" workflow step before ``docker build``; cleaned up
# afterwards). Should never be committed.
backend/__client_sdks_staged/

# Local virtual environments (any variant beyond the already-ignored .venv/)
.venv_local/
.venv-*/
.venv[0-9]*/

# Generated lint, typecheck, and test artifact dumps
*_lint.txt
*_mypy.txt
*_tsc.txt
*_errors.txt
mypy_errors.txt

# Local dev scratch
*.tmp
Thumbs.db

# Local agent/operator toolbox — vendored binaries (a ~56MB kubectl.exe), live
# UI backups, and one-off drill scripts. Machine-specific and sometimes huge, so
# it must never be committed; a `git add -A` swept it into a commit once and it
# had to be stripped back out before pushing.
.codex-tools/

# Large binary/design assets — use GitHub Releases or Git LFS instead
*.zip
*.tar.gz
*.tar.bz2

# maven-shade byproduct — generation is disabled in pom.xml, but keep this
# so an older checkout or a plugin-default change cannot dirty the tree again.
client/java/dependency-reduced-pom.xml
