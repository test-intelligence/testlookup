server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Request body cap (re-audit M26). nginx's default is 1 MB, so a report
    # upload through this proxy failed with nginx's own HTML 413 long before
    # the backend's 50 MiB limit (MAX_FILE_SIZE, backend/app/routers/ingest.py).
    # 55m = that 50 MiB cap + 5 MiB for multipart framing and form fields, so
    # the backend stays the authority and answers an oversize file with its
    # JSON 413. Pinned by backend/tests/regression/test_nginx_configs.py.
    client_max_body_size 55m;

    # ── Security headers ────────────────────────────────────────────────────
    # index.html carries a CSP <meta> tag, but browsers IGNORE frame-ancestors
    # when it arrives that way ("The Content Security Policy directive
    # 'frame-ancestors' is ignored when delivered via a <meta> element") — so
    # the anti-clickjacking intent stated in index.html was never enforced.
    # It only works as a response header, which is what this is.
    #
    # NGINX GOTCHA: add_header is inherited only when the child level declares
    # NO add_header of its own. Any location below that sets its own headers
    # must therefore REPEAT these, or it silently loses them — including
    # `location = /index.html`, the one document that actually matters here.
    #
    # HSTS (re-audit L1): TLS terminates in front of this container (the
    # cluster ingress / router); the header passes through to the browser over
    # HTTPS. Browsers ignore it on plain http:// (RFC 6797 §8.1), so Compose on
    # http://localhost is unaffected. One year; no includeSubDomains, because
    # the hosts BELOW an operator's TestLookup hostname are not ours to pin to
    # HTTPS.
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # index.html must NEVER be cached (re-audit M26): Vite hashes asset
    # filenames, so a new build emits new index-<hash>.js URLs and a fresh
    # index.html referencing them. A cached old index.html keeps loading the
    # old (and, after a redeploy, 404ing) asset hashes. The SPA fallback below
    # (`try_files ... /index.html`) is an internal redirect, so every client
    # route is served through this block too. Hashed assets stay long-cached.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires -1;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # SPA routing - send all requests to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to backend.
    # BACKEND_UPSTREAM is templated at container start via envsubst.
    # Defaults to "backend:8000" (docker-compose). In Kubernetes, set
    # BACKEND_UPSTREAM=testlookup-backend:8000 (or your service name).
    # When the cluster ingress already routes /api to the backend service,
    # this proxy is unused but remains as a safety net for direct
    # service/port-forward access to the frontend pod.
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Same-origin WebSocket endpoint used by the live execution UI. This also
    # keeps Compose and direct frontend port-forwards working when no cluster
    # ingress is present to route /ws independently.
    location /ws/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /webhooks/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;
    gzip_min_length 1000;

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # Repeated: this block declares its own add_header, so it would
        # otherwise inherit none of the server-level security headers.
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}
