exports[`TrendsPage flag-off DOM (Wave 2.6) > renders the Wave 2.5 page, apart from the intended responsive classes and the banner 1`] = `"<main class="w-full pb-10"><header class="flex items-end justify-between gap-3.5 mb-3.5 flex-wrap"><div class="min-w-0"><h1 class="text-[24px] font-bold leading-[1.1] m-0 text-[var(--color-text)]" style="letter-spacing: -0.01em;">Trends</h1><div class="flex items-center gap-2 mt-1 flex-wrap text-[13px] text-[var(--color-text-muted)]"><span>Project</span><code class="font-mono text-[11.5px] bg-[var(--color-bg-secondary)] border border-[var(--color-border)] px-1.5 py-px rounded-sm">Project One</code><span aria-hidden="true">·</span><span>Window</span><code class="font-mono text-[11.5px] bg-[var(--color-bg-secondary)] border border-[var(--color-border)] px-1.5 py-px rounded-sm">last 14 days</code><span aria-hidden="true">·</span><span>refreshed just now</span></div></div><div class="flex items-center gap-2 flex-wrap"><button type="button" title="Customize widgets" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[13px] text-[var(--color-text-muted)] hover:text-[var(--color-text)] border rounded-md transition-colors disabled:opacity-50" style="border-color: var(--color-border);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-grid h-3.5 w-3.5" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg>Customize</button><div role="tablist" aria-label="Time window" class="flex items-center gap-0 p-0.5 rounded-md" style="background: var(--color-bg-secondary); border: 1px solid var(--color-border);"><button role="tab" type="button" aria-selected="false" class="px-3 py-1 text-[13px] font-medium tabular-nums rounded-sm transition-colors text-[var(--color-text-muted)] hover:text-[var(--color-text)]">24h</button><button role="tab" type="button" aria-selected="false" class="px-3 py-1 text-[13px] font-medium tabular-nums rounded-sm transition-colors text-[var(--color-text-muted)] hover:text-[var(--color-text)]">7d</button><button role="tab" type="button" aria-selected="true" class="px-3 py-1 text-[13px] font-medium tabular-nums rounded-sm transition-colors bg-[var(--color-bg-card)] text-[var(--color-text)] shadow-[var(--shadow-sm)]">14d</button><button role="tab" type="button" aria-selected="false" class="px-3 py-1 text-[13px] font-medium tabular-nums rounded-sm transition-colors text-[var(--color-text-muted)] hover:text-[var(--color-text)]">30d</button><button role="tab" type="button" aria-selected="false" class="px-3 py-1 text-[13px] font-medium tabular-nums rounded-sm transition-colors text-[var(--color-text-muted)] hover:text-[var(--color-text)]">90d</button></div><label class="relative inline-flex items-center" title="Filter by test suite"><span class="sr-only">Test suite</span><select class="appearance-none pl-3 pr-8 py-1.5 text-[12.5px] font-medium rounded-md bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:border-[var(--color-border-light)] focus:outline-none focus:border-[var(--color-ring)] disabled:opacity-60 disabled:cursor-not-allowed max-w-[240px]"><option value="">All suites</option><option value="Checkout">Checkout</option></select><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down absolute right-2 top-1/2 -translate-y-1/2 h-3 w-3 text-[var(--color-text-muted)] pointer-events-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></label><button type="button" title="Export this trends view as a PDF" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[13px] text-[var(--color-text-muted)] hover:text-[var(--color-text)] border rounded-md transition-colors disabled:opacity-50" style="border-color: var(--color-border);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download h-3.5 w-3.5" aria-hidden="true"><path d="M12 15V3"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path></svg>Export PDF</button><button type="button" title="Email this trends view to the project recipients" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[13px] font-medium rounded-md transition-colors" style="background: var(--color-btn-primary-bg); color: white;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail h-3.5 w-3.5" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>Email report</button></div></header><section aria-label="Trend verdict" aria-live="polite" class="relative rounded-xl border overflow-hidden grid gap-6" style="background: radial-gradient(120% 100% at 0% 0%, var(--gate-conditional-bg-soft), transparent 55%), var(--color-bg-card); border-color: color-mix(in srgb, var(--status-broken) 40%, transparent); padding: 18px 20px; margin-bottom: 14px;"><span aria-hidden="true" class="absolute left-0 top-0 bottom-0 w-[3px]" style="background: var(--gate-conditional);"></span><div class="min-w-0" style="padding-left: 4px;"><span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase" style="color: var(--status-broken); letter-spacing: var(--tracking-wider);"><span class="h-1.5 w-1.5 rounded-full" style="background: var(--gate-conditional); animation: testlookup-pulse 1.6s ease-out infinite;" aria-hidden="true"></span>Trend signal</span><h2 class="font-bold m-0" style="font-size: var(--text-display-sm); line-height: 1.15; letter-spacing: -0.02em; margin: 6px 0px;"><span aria-label="Verdict: Trend mixed" style="color: var(--status-broken);">Trend mixed</span><span class="text-[var(--color-text-muted)] mx-2">·</span><span>4 active days · mixed signal</span></h2><p class="text-[13px] m-0 mb-3.5 max-w-[64ch]" style="color: var(--color-text-secondary);">Mixed signal across 4 active days — pass rate variance is moderate. Verify the recent failures before declaring a regression.</p><div class="flex flex-col gap-2"><div class="grid gap-2.5 items-center rounded-md border" style="padding: 10px 12px; background: var(--color-accent-bg-soft); border-color: color-mix(in srgb, var(--color-accent) 25%, transparent);"><span class="inline-flex items-center justify-center rounded-md" style="width: 22px; height: 22px; background: color-mix(in srgb, var(--color-accent) 16%, transparent); color: var(--color-accent);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert h-3 w-3" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg></span><div class="text-[13px] text-[var(--color-text)] leading-[1.4] issue-body">The latest active day had <strong>97 test executions</strong>: 61 passed, 17 failed, 8 broken (71% of 86 evaluated). <span class="text-[var(--color-text-muted)]">No regression vs. the prior in-window run.</span></div><button type="button" class="text-[11.5px] font-medium px-2 py-0.5 rounded-full border whitespace-nowrap transition-colors" style="color: var(--color-accent); border-color: color-mix(in srgb, var(--color-accent) 25%, transparent); background: var(--color-accent-bg-soft);">Compare runs →</button></div></div><div class="flex flex-wrap gap-2 mt-3.5"><button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[13px] font-medium rounded-md transition-colors" style="background: var(--color-btn-primary-bg); color: white;">Email this view</button><button type="button" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[13px] text-[var(--color-text-muted)] hover:text-[var(--color-text)] border rounded-md transition-colors disabled:opacity-50" style="border-color: var(--color-border);">Widen window to 90d</button><button type="button" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[13px] text-[var(--color-text-muted)] hover:text-[var(--color-text)] border rounded-md transition-colors disabled:opacity-50" style="border-color: var(--color-border);">Email this view</button></div></div><div class="flex flex-col gap-3.5 pt-0.5 min-w-0"><div><div class="text-[11px] uppercase font-medium text-[var(--color-text-muted)] mb-1.5" style="letter-spacing: var(--tracking-wider);">Trend confidence</div><div class="flex items-end justify-between"><div><span class="font-bold tabular-nums leading-none" style="font-size: var(--text-display-lg); color: var(--status-broken); letter-spacing: -0.02em;">51</span><span class="text-[13px] text-[var(--color-text-muted)] ml-1">/ 100</span></div><span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold" style="background: var(--gate-conditional-bg); border: 1px solid var(--gate-conditional-border); color: var(--status-broken);">Moderate</span></div><div role="meter" aria-valuenow="51" aria-valuemin="0" aria-valuemax="100" aria-valuetext="51 of 100, Moderate" aria-label="Trend confidence" data-gauge-bar="marker" data-measured="true" data-tone="warn" class="block mt-3"><div data-gauge-track="true" data-gauge-track-edge="inset" class="relative rounded-full" style="width: 100%; height: 6px; 