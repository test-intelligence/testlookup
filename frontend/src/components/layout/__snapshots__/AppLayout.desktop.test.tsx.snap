  <div class="flex flex-col flex-1 min-w-0 overflow-hidden">
    <header class="relative z-40 h-14 border-b backdrop-blur flex items-center px-6 gap-4 flex-shrink-0" style="border-color: var(--color-border); background: var(--color-bg-card);">
      <div class="flex-1 max-w-md relative">
        <svg aria-hidden="true" class="lucide lucide-search absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-[var(--color-text-muted)] pointer-events-none" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
          <path d="m21 21-4.34-4.34">
          <circle cx="11" cy="11" r="8">
        <input class="input pl-9 pr-9 h-9 text-sm" placeholder="Search tests, runs, defects… (Enter)" type="text" value="">
        <kbd aria-hidden="true" class="absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none hidden sm:inline-flex items-center justify-center h-5 min-w-[1.25rem] px-1 rounded border border-[var(--color-border)] bg-[var(--color-bg-secondary)] text-[11px] font-mono text-[var(--color-text-muted)]">
          "/"
      <select aria-label="Select project" class="bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-[var(--color-text-secondary)] text-sm rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-[var(--color-ring)]">
        <option value="">
          "— Select project —"
        <option value="all">
          "All Projects"
        <option value="p1">
          "Core UI"
      <div data-stub="release-picker">
      <div class="ml-auto">
        <div class="relative">
          <button aria-expanded="false" aria-haspopup="menu" aria-label="Help" class="p-2 rounded-lg text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg-secondary)] transition-colors" data-help-menu="" title="Help" type="button">
            <svg aria-hidden="true" class="lucide lucide-circle-question-mark w-5 h-5" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="10">
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3">
              <path d="M12 17h.01">
      <div class="relative">
        <button aria-label="Notifications (2 unread)" class="relative p-2 rounded-lg text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg-secondary)] transition-colors">
          <svg aria-hidden="true" class="lucide lucide-bell w-5 h-5" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
            <path d="M10.268 21a2 2 0 0 0 3.464 0">
            <path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326">
          <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] bg-[var(--status-failed)] text-white text-[11px] font-bold rounded-full flex items-center justify-center px-1">
            "2"
      <div class="relative border-l pl-4 h-full flex items-center" style="border-color: var(--color-border);">
        <button aria-expanded="false" aria-haspopup="menu" aria-label="Account menu" class="flex items-center gap-3 h-full rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-ring)]" type="button">
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-white font-bold text-xs flex-shrink-0 bg-[var(--color-accent-muted)]">
            "TU"
          <div class="flex flex-col justify-center items-start">
            <span class="text-sm font-medium text-[var(--color-text)] leading-none">
              "Test User"
            <span class="text-xs text-[var(--color-text-muted)] mt-1 leading-none">
              "Admin"
    <main class="relative flex-1 overflow-auto" id="main-content" tabindex="-1">
      <div class="mx-auto w-full max-w-[1600px] px-4 py-6 sm:px-6 lg:px-8 xl:px-10">
        <div>
          "Page"
        <div class="sr-only" data-chart-announcer="polite" role="status">
        <div aria-atomic="true" aria-live="assertive" class="sr-only" data-chart-announcer="assertive">"
`;

