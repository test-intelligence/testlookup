exports[`AppLayout at 1024 px and above: the shell origin/main shipped > /overview: elements, attributes and desktop classes are unchanged 1`] = `
"<div class="flex h-screen overflow-hidden bg-[var(--color-bg)]">
  <a class="fixed left-4 top-4 z-[100] -translate-y-20 rounded-md bg-[var(--color-btn-primary-bg)] px-4 py-2 text-sm font-semibold text-[var(--color-btn-primary-text)] shadow-lg transition-transform focus:translate-y-0" href="#main-content">
    "Skip to main content"
  <aside class="flex-shrink-0 border-r flex flex-col transition-[width] duration-150 w-56" data-sidebar="expanded" style="background: var(--color-bg-card); border-color: var(--color-border);">
    <div class="py-5 border-b flex items-center justify-center px-4" style="border-color: var(--color-border);">
      <span aria-label="testlookup" class="inline-flex items-baseline leading-none text-[20px]" role="img">
        <span style="font-family: var(--font-mono); font-weight: 500; color: var(--color-accent); font-size: 1.45em;">
          "["
        <span style="font-family: var(--font-sans); font-weight: 400; color: var(--color-text); letter-spacing: -0.02em;">
          "test"
          <b style="font-weight: 700;">
            "lookup"
        <span style="font-family: var(--font-mono); font-weight: 500; color: var(--color-accent); font-size: 1.45em;">
          "]"
    <nav aria-label="Main navigation" class="flex-1 py-4 overflow-y-auto px-3">
      <div class="mt-0.5">
        <a aria-current="page" class="sidebar-link relative active" data-discover="true" data-nav-id="home" href="/overview">
          <svg aria-hidden="true" class="lucide lucide-layout-dashboard h-4 w-4 flex-shrink-0" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
            <rect height="9" rx="1" width="7" x="3" y="3">
            <rect height="5" rx="1" width="7" x="14" y="3">
            <rect height="9" rx="1" width="7" x="14" y="12">
