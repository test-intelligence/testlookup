      <div class="mt-0.5">
        <a class="sidebar-link relative" data-discover="true" data-nav-id="reports" href="/reports/summary">
          <svg aria-hidden="true" class="lucide lucide-file-text h-4 w-4 flex-shrink-0" fill="none" height="24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
