# Site configuration for the single-node K3s path (homelabsetup/).
#
# Copy this file OUTSIDE the repository, fill it in, and point the scripts at
# it:
#
#   cp homelabsetup/homelab.env.example ~/.config/testlookup/homelab.env
#   export TESTLOOKUP_HOMELAB_ENV=~/.config/testlookup/homelab.env   # optional:
#   # ~/.config/testlookup/homelab.env is also read when the variable is unset
#
# Format: KEY=VALUE lines; blank lines, comments and `export ` are fine; one
# level of quotes is stripped. The file is read, never executed. A variable
# already set in your environment wins over the file. Never put secrets here:
# the deploy generates them and writes them to K3S_CREDENTIALS_FILE.
# Guide: docs/operations/deploy-k3s.md

# ── deploy-homelab.sh ─────────────────────────────────────────────────────
# Host name the Traefik ingress answers on (plain HTTP). *.localhost resolves
# to the loopback address, so the default works on the node itself; for any
# other name add a DNS or hosts-file entry for the Traefik LoadBalancer IP.
# On an EXISTING install the deploy refuses to change this (ALLOW_HOST_CHANGE=true
# overrides), so a missing or wrong config file cannot move your ingress.
K3S_HOST=testlookup.localhost

# Registry the cluster pulls the TestLookup images from (in-cluster registry on
# NodePort 30500). It must match the mirror in /etc/rancher/k3s/registries.yaml
# on every node, and your container engine must trust it as an insecure registry.
K3S_REGISTRY=registry.local:30500
# Optional second address of the same registry (e.g. <node-ip>:30500), tried
# when the registry host name does not resolve on the build machine.
#K3S_REGISTRY_FALLBACK=
# Node that stores the registry's data (default: the first node).
#K3S_REGISTRY_NODE=

# Directory of extra kustomize patches applied on every deploy, in file-name
# order. Each *.yaml is a strategic-merge patch that names the kind,
# metadata.name and metadata.namespace of what it changes, for example a
# hosted AI provider:
#
#   apiVersion: v1
#   kind: ConfigMap
#   metadata: {name: testlookup-config, namespace: testlookup}
#   data: {AI_OFFLINE_MODE: "false", LLM_PROVIDER: "openrouter", LLM_MODEL: "<model>"}
#
#K3S_PATCHES_DIR=

# Where a first install writes the generated secrets and the initial admin
# login (mode 600). Default: homelabsetup/.homelab-credentials (gitignored).
#K3S_CREDENTIALS_FILE=

# Models pulled into the in-cluster Ollama (skip with --skip-models).
#K3S_LLM_MODEL=qwen2.5:7b-instruct
#K3S_EMBEDDING_MODEL=nomic-embed-text:v1.5

# Initial admin account, used ONLY on a fresh install. Leave ADMIN_PASSWORD
# unset to have a random one generated and shown once. An existing admin is
# never modified by the deploy.
#ADMIN_USERNAME=admin
#ADMIN_EMAIL=admin@example.com

# ── bootstrap-homelab.sh (creates the K3s cluster over SSH) ───────────────
# Nodes as name=ip pairs; the first one runs the K3s server.
#K3S_NODES="node1=10.0.0.11"
#K3S_NODES="node1=10.0.0.11 node2=10.0.0.12 node3=10.0.0.13"
# SSH user with sudo on every node (key auth preferred; passwords come from
# HOMELAB_NODE<n>_PASS or a prompt and are never stored).
#K3S_NODE_USER=
# MetalLB address range for LoadBalancer services (not needed with --skip-prereqs).
#K3S_LB_RANGE=10.0.0.240-10.0.0.250
#K3S_LB_POOL_NAME=homelab-pool
# Host name the nodes and your build machine use for the registry.
#K3S_REGISTRY_HOST=registry.local
# Where bootstrap writes the cluster's kubeconfig.
#K3S_KUBECONFIG_OUT=~/.kube/config-testlookup-k3s
