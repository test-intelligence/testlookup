# ============================================================================
# artifactory.env — config for deploy-openshift-artifactory.sh
# ============================================================================
# Copy to ``openshiftsetup/artifactory.env`` and fill in. That file is
# gitignored (see .gitignore entry). Every value can also be supplied as an
# environment variable; the env var wins over this file.
# ============================================================================

# ── Artifactory (the ONE registry the cluster can reach) ────────────────────
# The base path under which ALL images live (app images + mirrored infra
# images). No scheme, no trailing slash. This is a Docker repository in
# Artifactory — typically host + repo-key.
#   Example: artifactory.example.com/testlookup-docker
ARTIFACTORY_REGISTRY="artifactory.example.com/testlookup-docker"

# What the CLUSTER uses to pull, IF it differs from the push address above
# (e.g. you push to a local-repo and the cluster pulls via a virtual-repo, or
# the cluster resolves a different hostname). Leave blank to reuse
# ARTIFACTORY_REGISTRY for both push and pull.
ARTIFACTORY_PULL_REGISTRY=""

# Credentials — used for ``docker login`` (push) AND baked into the in-cluster
# image pull secret. Use an Artifactory API key / identity token as the
# password for CI-friendly auth.
ARTIFACTORY_USERNAME="deploy-bot"
ARTIFACTORY_PASSWORD="<artifactory-api-key-or-password>"
ARTIFACTORY_EMAIL="deploy-bot@example.com"

# ── Routes / HTTPS ──────────────────────────────────────────────────────────
# Easiest: set the cluster's apps wildcard domain and let the script derive
# the three hostnames (testlookup / testlookup-api / testlookup-mcp).
#   APPS_DOMAIN=apps.ocp.example.com  ->  testlookup.apps.ocp.example.com, etc.
APPS_DOMAIN="apps.ocp.example.com"

# ...or pin each hostname explicitly (these override APPS_DOMAIN when set):
ROUTE_HOST_FRONTEND=""
ROUTE_HOST_API=""
ROUTE_HOST_MCP=""

# Optional custom TLS cert for the Routes (edge termination). Leave blank to
# use the OpenShift router's default wildcard cert for *.APPS_DOMAIN (valid
# HTTPS out of the box on a standard cluster). Provide PEM file paths to pin
# your own cert — the script injects them into all three Routes after apply.
ROUTE_TLS_CERT=""     # path to server certificate (PEM)
ROUTE_TLS_KEY=""      # path to private key (PEM)
ROUTE_TLS_CACERT=""   # path to CA chain (PEM), optional

# ── Cluster / storage ───────────────────────────────────────────────────────
NAMESPACE="testlookup"
# PVC storage class. Leave blank to auto-detect the cluster's default
# StorageClass. Set explicitly for predictability (e.g. gp3-csi,
# ocs-storagecluster-ceph-rbd, thin-csi, managed-csi).
STORAGE_CLASS=""

# Grant the ``anyuid`` SCC to the namespace default ServiceAccount so the
# stock third-party infra images (postgres/mongo/minio/chroma/nginx) and the
# frontend nginx can run with their expected UIDs. Set to "false" on hardened
# clusters where you've pre-provisioned an SCC or use UID-agnostic images.
GRANT_ANYUID="true"

# ── Initial admin user (created via scripts/createAdmin.py in the backend) ──
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@2026!"
ADMIN_EMAIL="admin@example.com"
ADMIN_FULL_NAME="TestLookup Admin"

# ── Infra images to mirror into Artifactory ─────────────────────────────────
# Pinned to the exact versions the manifests reference. Override only if you
# bump a version in the overlay too. Space-separated upstream refs; the script
# pulls each on the (internet-connected) build host, retags under
# ARTIFACTORY_REGISTRY preserving the repo path, and pushes.
INFRA_IMAGES="postgres:16-alpine redis:7-alpine mongo:7 minio/minio:RELEASE.2025-09-07T16-13-09Z chromadb/chroma:0.5.20 ollama/ollama:0.5.4 busybox:1.36"

# Pull Ollama models into the in-cluster Ollama after deploy. In an air-gapped
# cluster Ollama can't reach the internet, so this only works if your Ollama
# is fronted by an Artifactory/proxy mirror. Default off.
PULL_OLLAMA_MODELS="false"
OLLAMA_MODELS="qwen2.5:7b nomic-embed-text"
