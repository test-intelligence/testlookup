# ============================================================================
# artifactory.env — config for deploy-openshift-artifactory.sh
# ============================================================================
# Copy to ``openshiftsetup/artifactory.env`` and fill in. That file is
# gitignored (see .gitignore entry). Every value can also be supplied as an
# environment variable; the env var wins over this file.
# ============================================================================

# ── Artifactory (the ONE registry the cluster can reach) ────────────────────
# The base path under which ALL images live (app images + mirrored infra
# images). No scheme, no trailing slash. This is a Docker repository in
# Artifactory — typically host + repo-key.
#   Example: artifactory.example.com/testlookup-docker
ARTIFACTORY_REGISTRY="artifactory.example.com/testlookup-docker"

# What the CLUSTER uses to pull, IF it differs from the push address above
# (e.g. you push to a local-repo and the cluster pulls via a virtual-repo, or
# the cluster resolves a different hostname). Leave blank to reuse
# ARTIFACTORY_REGISTRY for both push and pull.
ARTIFACTORY_PULL_REGISTRY=""

# Credentials — used for ``docker login`` (push) AND baked into the in-cluster
# image pull secret. Use an Artifactory API key / identity token as the
# password for CI-friendly auth.
ARTIFACTORY_USERNAME="deploy-bot"
ARTIFACTORY_PASSWORD="<artifactory-api-key-or-password>"
ARTIFACTORY_EMAIL="deploy-bot@example.com"

# ── Routes / HTTPS ──────────────────────────────────────────────────────────
# Easiest: set the cluster's apps wildcard domain and let the script derive
# the three hostnames (testlookup / testlookup-api / testlookup-mcp).
#   APPS_DOMAIN=apps.ocp.example.com  ->  testlookup.apps.ocp.example.com, etc.
APPS_DOMAIN="apps.ocp.example.com"

# ...or pin each hostname explicitly (these override APPS_DOMAIN when set):
ROUTE_HOST_FRONTEND=""
ROUTE_HOST_API=""
ROUTE_HOST_MCP=""

# Optional custom TLS cert for the Routes (edge termination). Leave blank to
# use the OpenShift router's default wildcard cert for *.APPS_DOMAIN (valid
# HTTPS out of the box on a standard cluster). Provide PEM file paths to pin
# your own cert — the script injects them into all three Routes after apply.
ROUTE_TLS_CERT=""     # path to server certificate (PEM)
ROUTE_TLS_KEY=""      # path to private key (PEM)
ROUTE_TLS_CACERT=""   # path to CA chain (PEM), optional

# ── Cluster / storage ───────────────────────────────────────────────────────
NAMESPACE="testlookup"
# PVC storage class. Leave blank to auto-detect the cluster's default
# StorageClass. Set explicitly for predictability (e.g. gp3-csi,
# ocs-storagecluster-ceph-rbd, thin-csi, managed-csi).
STORAGE_CLASS=""

# Security context constraints (need cluster-admin; the script only warns when
# it may not grant them).
#
# GRANT_ANYUID: grant the ``anyuid`` SCC to the ``testlookup-anyuid``
# ServiceAccount only. The stock third-party images that start as root or with
# their own UID run under it: postgres, mongo, valkey, the object store,
# chroma and ollama. Nothing else in the namespace gets ``anyuid``. Set to
# "false" on hardened clusters where you've pre-provisioned an SCC for that
# ServiceAccount or use UID-agnostic images.
GRANT_ANYUID="true"
# GRANT_NONROOT: grant the ``nonroot-v2`` SCC (a fixed, non-zero UID; never
# root) to ``testlookup-sa`` (API, workers) and to the namespace ``default``
# ServiceAccount (frontend, MCP, backup jobs, the migration Job). The
# application images run as UID 1000 / 101, which the ``restricted-v2`` SCC
# does not admit.
GRANT_NONROOT="true"
# An install made by an older version of the script granted ``anyuid`` to the
# ``default`` ServiceAccount. Set to "true" for ONE run to take that grant
# away after the new pods are up (or run the command the script prints).
REVOKE_DEFAULT_ANYUID="false"

# ── Data-store passwords ────────────────────────────────────────────────────
# Redis (Valkey): always on. The script generates the password once, keeps it
# in the ``testlookup-secrets`` Secret and reuses it on every run.
#
# MongoDB: authentication is OFF until you set this to "true". The script then
# generates a root user, creates it in the running MongoDB, stores it in the
# Secret, and restarts MongoDB and its clients. Before you switch it on for an
# install that has data:
#   1. take a backup (k8s/components/backup/README.md);
#   2. make sure the testlookup-mongo pod is Running (the script creates the
#      user in it and stops, changing nothing, if it cannot);
#   3. expect MongoDB and the application pods to restart once.
# Once on it stays on: setting this back to "false" does not switch it off.
ENABLE_MONGO_AUTH="false"

# ── Initial admin user (created by /app/scripts/create_admin.py in the backend) ──
ADMIN_USERNAME="admin"
# Leave ADMIN_PASSWORD empty to have the deploy script generate a random one;
# it is printed ONCE in the final summary — store it in your password manager.
# Set it only if you need a known value (then keep this file out of git).
ADMIN_PASSWORD=""
ADMIN_EMAIL="admin@example.com"
ADMIN_FULL_NAME="TestLookup Admin"

# ── Infra images to mirror into Artifactory ─────────────────────────────────
# Leave unset: the list is derived from deploy/images.manifest.txt (the single
# source of truth), so it always matches the manifests you deploy. Set it only
# to mirror a subset — space-separated upstream refs; the script pulls each on
# the (internet-connected) build host, retags under ARTIFACTORY_REGISTRY
# preserving the repo path, and pushes. Example:
# INFRA_IMAGES="postgres:16-alpine valkey/valkey:8.1-alpine mongo:7"
# MongoDB (mongo:7) is SSPL-1.0 and is pulled from its upstream registry by you.

# Pull Ollama models into the in-cluster Ollama after deploy. In an air-gapped
# cluster Ollama can't reach the internet, so this only works if your Ollama
# is fronted by an Artifactory/proxy mirror. Default off. Names must match
# LLM_MODEL / EMBEDDING_MODEL exactly (both Apache-2.0).
PULL_OLLAMA_MODELS="false"
OLLAMA_MODELS="qwen2.5:7b-instruct nomic-embed-text:v1.5"
