    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 40,
      "title": "SLO Compliance",
      "description": "Per-endpoint p95 latency vs documented budgets. Thresholds and queries mirror infra/monitoring/prometheus-rules/testlookup-alerts.yml::testlookup.slo and backend/app/services/performance_budgets.py::LATENCY_BUDGETS — change one and the test_slo_alerts_match_budgets ratchet will tell you to update the others.",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "p95 over a 5m rolling window for every endpoint covered by an SLO alert. Each series is annotated with its budget in the legend.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 37 },
      "id": 41,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"testlookup-backend\", handler=\"/api/v1/projects\", method=\"GET\"}[5m])))",
          "legendFormat": "project_list (budget 200ms)",
          "refId": "A"
