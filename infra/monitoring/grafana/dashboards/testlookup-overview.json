        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"testlookup-backend\", handler=\"/api/v1/runs\", method=\"GET\"}[5m])))",
          "legendFormat": "run_list (budget 250ms)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"testlookup-backend\", handler=\"/api/v1/runs/{run_id}\", method=\"GET\"}[5m])))",
          "legendFormat": "run_scoped_guard (budget 250ms)",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"testlookup-backend\", handler=\"/api/v1/runs/{run_id}/intelligence\", method=\"GET\"}[5m])))",
          "legendFormat": "run_intelligence (budget 800ms)",
          "refId": "D"
