          "legendFormat": "flaky_coach (budget 600ms)",
          "refId": "F"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"testlookup-backend\", handler=\"/health/details\", method=\"GET\"}[5m])))",
          "legendFormat": "health_details (budget 2.5s)",
          "refId": "G"
        }
