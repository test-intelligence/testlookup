# Copy to a per-env file (see environments/) or pass with -var-file.
# These are SAFE EXAMPLE values — no secrets live here.

environment         = "dev"
region              = "us-east-1"
allowed_account_ids = [] # e.g. ["123456789012"] to hard-guard the target account

vpc_cidr           = "10.40.0.0/16"
az_count           = 2
single_nat_gateway = true

cluster_version     = "1.30"
node_instance_types = ["t3.large"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4

# Both are off by default; read the variable descriptions before turning them on.
# enable_network_policy: the VPC CNI enforces NetworkPolicy. Turn it on for any
#   cluster other workloads share. The aws-eks overlay admits the ALB to the
#   frontend, backend and MCP pods; narrow its 0.0.0.0/0 to the output
#   public_subnet_cidrs.
# require_imdsv2: nodes require IMDSv2 with a hop limit of 1. On an existing
#   cluster this REPLACES the node group; the AWS Load Balancer Controller then
#   needs its own IRSA role, region and vpcId.
# enable_network_policy = true
# require_imdsv2        = true

rds_instance_class   = "db.t3.medium"
rds_multi_az         = false
docdb_instance_count = 1
redis_replicas       = 0
