# TestLookup MCP Server — Cloud Run environment variables
# Copy to infra/cloudrun/mcp.env and replace placeholders.
# Upload with:
#   gcloud secrets versions add testlookup-mcp-env --data-file=infra/cloudrun/mcp.env

# Backend URL — use the Cloud Run backend service URL
TESTLOOKUP_API_URL=https://testlookup-backend-xxxx-uc.a.run.app

# MCP service account credentials (must match a registered user in the backend)
# Create via: POST /api/v1/auth/register
TESTLOOKUP_USERNAME=mcp-service-account
TESTLOOKUP_PASSWORD=CHANGE_ME_STRONG

# HTTP timeout in seconds (increase for slow LLMs; AI analysis can take 60+s)
TESTLOOKUP_REQUEST_TIMEOUT=120.0
