# TestLookup MCP Server — Environment Variables
# Copy to .env and fill in values before running.
#
# For Claude Desktop (stdio mode): set these in the mcpServers.env block
# in ~/.claude/claude_desktop_config.json instead.

# Backend URL (default: local dev stack)
TESTLOOKUP_API_URL=http://localhost:8000

# Credentials for local stdio only (optional).
# Network SSE clients must send their own Authorization: Bearer token; the
# deployed MCP server never reads these values or owns a shared account.
TESTLOOKUP_USERNAME=your-username
TESTLOOKUP_PASSWORD=your-password

# HTTP timeout in seconds (increase for slow LLMs; AI analysis can take 60+s)
TESTLOOKUP_REQUEST_TIMEOUT=120.0

# Network authentication has its own short timeout and bounded pool.
TESTLOOKUP_AUTH_TIMEOUT=5.0
TESTLOOKUP_AUTH_MAX_CONNECTIONS=50

# Comma-separated exact Host and Origin allowlists for SSE. ``:*`` permits any
# port for that exact local hostname. Add the TLS ingress host in deployments.
TESTLOOKUP_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
TESTLOOKUP_MCP_ALLOWED_ORIGINS=
