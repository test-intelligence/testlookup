# Build-context exclusions for the MCP server image.
#
# Build context is ``mcp/`` (see homelabsetup/deploy-homelab.sh:361).
# Same shape as backend/.dockerignore but smaller — the MCP module
# doesn't carry SDK staging or large test fixtures.

# ── Python build artifacts / caches ──────────────────────────────────
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ── Local virtualenvs ────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Secrets ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── IDE / OS clutter ─────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db

# ── Logs / docs ──────────────────────────────────────────────────────
*.log
README.md
*.md

# ── pytest caches / basetemp roots ───────────────────────────────────
# These are permission-locked on Windows, and podman aborts the ENTIRE
# image build reading their extended attributes:
#   copier: get: getting extended attributes for "/.pytest-cache-m10":
#   permission denied
# That failure cost a homelab deploy from backend/, whose ignore covered
# the underscore spelling but not the hyphenated one. Both separators are
# matched here so this context cannot repeat it.
.pytest_cache/
**/.pytest_cache/
.pytest_tmp*/
**/.pytest_tmp*/
.pytest-*/
**/.pytest-*/
