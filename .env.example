# ============================================================
# TestLookup — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=TestLookup
# SECURE DEFAULT: production. In production/staging the app refuses to start
# with default secrets (see JWT_SECRET_KEY / APP_SECRET_KEY below) and the
# passwordless dev-login endpoint is disabled. `make dev` / `make quickstart`
# (via scripts/gen-dev-env.sh) flip this to `development` for local convenience.
APP_ENV=production           # development | staging | production
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_DEBUG=false
APP_VERSION=0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Externally-reachable URL for the dashboard (used to build links rendered in
# Jira tickets, Slack/Teams notifications, and emails). Should match the
# ingress hostname users actually open in their browser. When unset, defaults
# to the first CORS_ORIGINS entry.
#   Examples:
    #     PUBLIC_BASE_URL=https://testlookup.example.com    # cloud k8s
#     PUBLIC_BASE_URL=http://testlookup.local           # homelab k3s
PUBLIC_BASE_URL=

# ── Storage backend ──────────────────────────────────────────
# minio = use MinIO (default for Docker Compose)
# local = write to LOCAL_STORAGE_PATH (useful if MinIO is unavailable)
STORAGE_BACKEND=minio
# LOCAL_STORAGE_PATH=/tmp/testlookup_data   # only used when STORAGE_BACKEND=local

# ── Development helpers ───────────────────────────────────────
# Exposes POST /api/v1/auth/dev-login — issues a JWT for the admin WITHOUT
# credentials. Only active when APP_ENV=development. SECURE DEFAULT: false.
# `make dev` / gen-dev-env.sh set this to true (alongside APP_ENV=development)
# for local use. Leave false for any real deployment.
DEV_AUTO_LOGIN_ENABLED=false

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433           # Docker exposes 5433→5432 to avoid conflict with any local PostgreSQL
POSTGRES_DB=testlookup
POSTGRES_USER=testlookup_user
POSTGRES_PASSWORD=<set-a-strong-password>
DATABASE_URL=postgresql+asyncpg://testlookup_user:<your-postgres-password>@localhost:5433/testlookup

# ── MongoDB ──────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=testlookup_logs
# Required: unauthenticated MongoDB is rejected at compose-up.
# Generate a strong password: openssl rand -base64 32
MONGO_USER=testlookup
MONGO_PASSWORD=change-me-to-a-strong-password
MONGO_URI=mongodb://testlookup:change-me-to-a-strong-password@localhost:27017/testlookup_logs?authSource=admin

# Flower (Celery monitoring UI) HTTP basic auth — required.
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-to-a-strong-password

# ── MinIO (S3-compatible Object Storage) ─────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=testlookup_minio
MINIO_SECRET_KEY=<set-a-strong-secret-key>
MINIO_BUCKET_NAME=test-telemetry
MINIO_USE_SSL=false

# ── Redis (Celery message broker + authz cache) ──────────────
# Redis is the Celery broker (task injection = code execution), the JWT
# revocation store, and the membership authz cache — it must NOT be reachable
# unauthenticated. Set a password; Docker Compose passes it to the server's
# --requirepass and embeds it in the container REDIS_URL/CELERY_* automatically.
# Generate: openssl rand -hex 24. Leave empty only for a purely internal,
# non-published Redis.
REDIS_PASSWORD=
# For the Compose stack the value below is overridden with the redis:// service
# host + the password above. When running the backend on the HOST against a
# password-protected Redis, embed it here: redis://:<password>@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider Configuration ───────────────────────────────
# Provider: ollama (default/offline) | lmstudio | localai | vllm | openai | gemini
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Ollama (local — no internet required)
OLLAMA_BASE_URL=http://localhost:11434

# LM Studio (local desktop app)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# LocalAI (air-gapped server)
# LOCALAI_BASE_URL=http://localhost:8080/v1

# vLLM (GPU production server)
# VLLM_BASE_URL=http://localhost:8000/v1

# OpenAI (cloud — requires internet)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-your-key-here

# Google Gemini (cloud — requires internet)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-pro
# GOOGLE_API_KEY=your-google-api-key

# ── Embedding Configuration ───────────────────────────────────
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# ── ChromaDB (Vector Store for Semantic Search) ───────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=testlookup_embeddings

# ── AI Agent Settings ─────────────────────────────────────────
AI_OFFLINE_MODE=true          # true = enforce local-only; false = allow cloud APIs
AI_CONFIDENCE_THRESHOLD=80    # Minimum confidence for auto-Jira ticket creation
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=120

# ── Analysis Engine Mode ─────────────────────────────────────
# Controls which engine classifies test failures and generates summaries.
#   auto  = ML if trained model available, else LLM if reachable, else Rules
#   llm   = Full LangChain ReAct agent (requires running LLM provider above)
#   ml    = scikit-learn ML classifier (no LLM needed, requires trained model)
#   rules = Pattern matching + statistical heuristics (zero external dependencies)
# Changeable at runtime via Settings > AI Configuration (ADMIN only).
ANALYSIS_MODE=auto
ML_MODEL_DIR=models/          # Directory for trained .joblib model artifacts
ML_MIN_TRAINING_SAMPLES=200   # Minimum labeled samples before ML mode activates
ML_RETRAIN_ENABLED=true       # Enable nightly model retraining via Celery beat
ML_ACCURACY_THRESHOLD=0.80    # Minimum accuracy to deploy a newly trained model

# ── Jira Integration (Optional — Phase 5) ────────────────────
JIRA_ENABLED=false
JIRA_DOMAIN=yourcompany.atlassian.net
JIRA_EMAIL=admin@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_DEFAULT_PROJECT_KEY=QA

# ── Confluence Integration (Optional — Knowledge RAG) ───────
CONFLUENCE_ENABLED=false
CONFLUENCE_DOMAIN=yourcompany.atlassian.net
CONFLUENCE_EMAIL=admin@yourcompany.com
CONFLUENCE_API_TOKEN=your-confluence-api-token

# ── Splunk Integration (Optional — Phase 5) ──────────────────
SPLUNK_ENABLED=false
SPLUNK_BASE_URL=https://your-splunk-instance:8089
SPLUNK_API_TOKEN=your-splunk-token
SPLUNK_INDEX=main

# ── OpenShift / Kubernetes Integration ───────────────────────
OCP_ENABLED=false
OCP_API_URL=https://api.your-cluster.com:6443
OCP_SA_TOKEN=your-service-account-token
OCP_DEFAULT_NAMESPACE=qa-testing

# ── Notification Integrations (Optional — Phase 6) ───────────
SLACK_ENABLED=false
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_URL=replace-with-slack-webhook-url
SLACK_DEFAULT_CHANNEL=#qa-alerts

TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=https://yourorg.webhook.office.com/webhookb2/...

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@testlookup.io

# ── Authentication & Security ─────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720   # 12 hours (testing app)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7       # 7 days

# Shared secret for MinIO webhook endpoint (X-Webhook-Secret header)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Celery Worker ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=4

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | text

# ── E2E / Playwright tests ────────────────────────────────────
# Only required when DEV_AUTO_LOGIN_ENABLED=false (e.g. CI/staging).
# In local dev mode the test suite uses the /dev-login endpoint instead.
E2E_ADMIN_PASSWORD=<set-only-if-dev-login-is-disabled>

# ── Knowledge RAG (grounded test generation) ─────────────────
KNOWLEDGE_RAG_ENABLED=false

# ── Monitoring (optional overlay) ─────────────────────────────
# Required when using docker-compose.monitoring.yml
# Generate with: openssl rand -hex 16
GF_SECURITY_ADMIN_PASSWORD=<set-a-grafana-admin-password>
